# Copy this file to .env (development) and .env.production (production build),
# then fill in the backend for each. The real .env files are not committed.
#
# Note: VITE_ variables are built into the browser JavaScript, so anyone can
# read them. Never put a secret (API secret, password, private key) here.

# Development:  https://api-dev.buildfree.dev/api/v1
# Production:   https://api.buildfree.dev/api/v1
VITE_API_BASE_URL=https://api-dev.buildfree.dev/api/v1
