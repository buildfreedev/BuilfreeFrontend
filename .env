# Development backend (separate from production). Its CORS allows
# http://localhost:5173 with credentials, so the session cookie works locally.
VITE_API_BASE_URL=https://api-dev.buildfree.dev/api/v1

# Fallback if CORS ever blocks the dev server: use the Vite proxy in
# vite.config.js instead.
# VITE_API_BASE_URL=/api/v1
